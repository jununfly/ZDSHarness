  "license": "MIT",
  "dependencies": { "@deepseek-ai/dsh-github-rest": "workspace:^", "@deepseek-ai/dsh-home-paths": "workspace:^", "@deepseek-ai/dsh-research": "workspace:^", "@deepseek-ai/dsh-research-report": "workspace:^" },
  "peerDependencies": { "@deepseek-ai/dsh-github": "workspace:^", "@deepseek-ai/dsh-invariants": "workspace:^", "@deepseek-ai/cordis": "workspace:^" },
  "devDependencies": { "@deepseek-ai/dsh-github": "workspace:^", "@deepseek-ai/dsh-invariants": "workspace:^", "@deepseek-ai/cordis": "workspace:^" }
