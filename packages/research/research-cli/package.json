{
  "name": "@deepseek-ai/dsh-research-cli",
  "description": "Standalone JSON protocol for the shared research compiler",
  "version": "0.1.0-rc.5",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/research/research-cli" },
  "type": "module",
  "main": "lib/index.js",
